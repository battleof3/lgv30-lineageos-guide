diff --git a/sound/soc/codecs/tfa9872/tfa98xx.c b/sound/soc/codecs/tfa9872/tfa98xx.c
index 1c38d1a9..b7a166ff 100644
--- a/sound/soc/codecs/tfa9872/tfa98xx.c
+++ b/sound/soc/codecs/tfa9872/tfa98xx.c
@@ -116,6 +116,40 @@ static int pcm_no_constraint = 0;
 module_param(pcm_no_constraint, int, S_IRUGO);
 MODULE_PARM_DESC(pcm_no_constraint, "do not use constraints for PCM paramaters\n");
 
+/* LG V30: TDM slot the speaker plays (TDMSPKS; the DCDC sink TDMDCS takes the other one),
+ * reapplied on every start since the amp is I2C-reset each time. -1 keeps the POR values
+ * (speaker slot 0 = left channel, DCDC slot 1). */
+int lgv30_spk_slot = -1;
+module_param(lgv30_spk_slot, int, S_IRUGO | S_IWUSR);
+MODULE_PARM_DESC(lgv30_spk_slot, "speaker TDM slot: -1 default, 0 left, 1 right\n");
+
+/* Rotation: msm-pcm-routing's "Swap channel" control moves the speaker to the other slot. Cleared
+ * whenever the amp stops; the audio HAL sets it again on the next start if still rotated. */
+static bool lgv30_spk_swap;
+static struct tfa98xx *lgv30_tfa;
+
+int lgv30_spk_effective_slot(void)
+{
+	if (lgv30_spk_slot < 0 || lgv30_spk_slot > 1)
+		return -1;
+	return lgv30_spk_swap ? 1 - lgv30_spk_slot : lgv30_spk_slot;
+}
+
+/* Returns false when lgv30_spk_slot is off, so the caller keeps its stock behaviour. */
+bool lgv30_tfa_set_swap(bool swap)
+{
+	int slot;
+
+	if (lgv30_spk_slot < 0 || lgv30_spk_slot > 1)
+		return false;
+	lgv30_spk_swap = swap;
+	slot = lgv30_spk_effective_slot();
+	/* Takes effect live; tfa_start() reapplies it after the amp's I2C reset. */
+	if (lgv30_tfa)
+		regmap_update_bits(lgv30_tfa->regmap, 0x26, 0xff, ((1 - slot) << 4) | slot);
+	return true;
+}
+
 #if defined(USE_TFA9891)
 static void tfa98xx_tapdet_check_update(struct tfa98xx *tfa98xx);
 #endif
@@ -3363,6 +3397,7 @@ static int _tfa98xx_stop(struct tfa98xx *tfa98xx)
 	mutex_lock(&tfa98xx->dsp_lock);
 	pr_info("%s: stop tfa amp \n", __func__);
 	tfa_stop();
+	lgv30_spk_swap = false;
 	tfa98xx->dsp_init = TFA98XX_DSP_INIT_STOPPED;
 	mutex_unlock(&tfa98xx->dsp_lock);
 
@@ -3752,6 +3787,7 @@ static int tfa98xx_i2c_probe(struct i2c_client *i2c,
 	}
 
 	i2c_set_clientdata(i2c, tfa98xx);
+	lgv30_tfa = tfa98xx;
 	mutex_init(&tfa98xx->dsp_lock);
 	init_waitqueue_head(&tfa98xx->wq);
 
