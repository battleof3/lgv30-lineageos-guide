+			if (slot >= 0) {
+				tfa_set_bf(dev, 0x2603 /* TFA9872 TDMSPKS */, (uint16_t)slot);
+				tfa_set_bf(dev, 0x2643 /* TFA9872 TDMDCS */, (uint16_t)(1 - slot));
+			}
+		}
 		tfa_run_unmute(dev);	/* unmute */
 		tfa_cont_close(dev); /* close all of them */
 	}
