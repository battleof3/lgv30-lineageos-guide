@@ -4035,6 +4035,8 @@ enum tfa98xx_error tfa_run_wait_calibration(tfa98xx_handle_t handle, int *calibr
 	return err;
 }
 
+extern int lgv30_spk_effective_slot(void);
+
 enum tfa98xx_error tfa_start(int next_profile, int *vstep)
 {
 	enum tfa98xx_error err = TFA98XX_ERROR_OK;
@@ -4192,6 +4194,16 @@ enum tfa98xx_error tfa_start(int next_profile, int *vstep)
 		if (tfa98xx_runtime_verbose && (tfa98xx_dev_family(dev) == 2))
 			show_current_state(dev);
 
+		/* Speaker sink and DCDC sink must use different slots (POR: 0 and 1) or the amp flags
+		 * a TDM LUT error, so move the DCDC sink to the other slot as well. */
+		{
+			int slot = lgv30_spk_effective_slot();
