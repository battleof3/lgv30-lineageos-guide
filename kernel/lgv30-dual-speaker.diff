+++ b/sound/soc/msm/qdsp6v2/msm-pcm-routing-v2.c
@@ -22436,6 +22436,60 @@ static int msm_routing_stereo_channel_reverse_control_get(
 	return 0;
 }
 
+#if defined(CONFIG_SND_SOC_TFA9872)
+extern bool lgv30_tfa_set_swap(bool swap);
+
+static struct snd_kcontrol *lgv30_find_ctl(struct snd_card *card, const char *name)
+{
+	struct snd_ctl_elem_id id;
+
+	memset(&id, 0, sizeof(id));
+	id.iface = SNDRV_CTL_ELEM_IFACE_MIXER;
+	strlcpy(id.name, name, sizeof(id.name));
+	return snd_ctl_find_id(card, &id);	/* controls_rwsem is held by the caller's write */
+}
+
+/*
+ * LG V30 dual speaker: the earpiece is fed through IIR1, input 0 = left, input 1 = right, with one
+ * of them at 0 (-84 dB). Swapping exchanges the two input levels. Any other state (calls, dual
+ * speaker off: neither or both inputs muted) is left untouched.
+ */
+static void lgv30_swap_earpiece(struct snd_kcontrol *kcontrol, bool swap)
+{
+	struct snd_soc_platform *platform = snd_soc_kcontrol_platform(kcontrol);
+	struct snd_card *card = platform->component.card->snd_card;
+	struct snd_kcontrol *k0 = lgv30_find_ctl(card, "IIR1 INP0 Volume");
+	struct snd_kcontrol *k1 = lgv30_find_ctl(card, "IIR1 INP1 Volume");
+	struct snd_ctl_elem_value *v0 = NULL, *v1 = NULL;
+	long a, b;
+
+	if (!k0 || !k1)
+		return;
+	v0 = kzalloc(sizeof(*v0), GFP_KERNEL);
+	v1 = kzalloc(sizeof(*v1), GFP_KERNEL);
+	if (!v0 || !v1)
+		goto out;
+	v0->id = k0->id;
+	v1->id = k1->id;
+	if (k0->get(k0, v0) < 0 || k1->get(k1, v1) < 0)
+		goto out;
+	/* These SX volume controls read back levels below 0 dB (84) as value + 256. */
+	a = v0->value.integer.value[0] % 256;
+	b = v1->value.integer.value[0] % 256;
+	if ((a == 0) == (b == 0))
+		goto out;
+	if ((a == 0) != swap) {		/* left muted = earpiece currently plays right = swapped */
+		v0->value.integer.value[0] = b;
+		v1->value.integer.value[0] = a;
+		k0->put(k0, v0);
+		k1->put(k1, v1);
+	}
+out:
+	kfree(v0);
+	kfree(v1);
+}
+#endif
+
 static int msm_routing_stereo_channel_reverse_control_put(
 			struct snd_kcontrol *kcontrol,
