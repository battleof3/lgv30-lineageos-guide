+#if LINUX_VERSION_CODE <= KERNEL_VERSION(4, 19, 0)
+/*
+ * Called from check_nnp_nosuid() in security/selinux/hooks.c. /data is mounted nosuid, so
+ * init's `exec u:r:ksu:s0 -- /data/adb/ksud services|boot-completed` needs init -> ksu to be
+ * a bounded transition, which it is not. Once the execve hook is stopped (at zygote start),
+ * RKSU no longer escapes init to ksu before exec, so permit exactly init -> ksu here.
+ */
+bool is_ksu_transition(const struct task_security_struct *old_tsec, const struct task_security_struct *new_tsec)
+{
+    if (!cached_init_sid || !cached_su_sid)
+        return false;
+
+    return old_tsec->sid == cached_init_sid && new_tsec->sid == cached_su_sid;
+}
+#endif
