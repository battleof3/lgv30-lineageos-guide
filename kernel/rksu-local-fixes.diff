diff --color -ruN rksu-pristine/kernel/infra/kernel_compat.h ../kernel-src/KernelSU/kernel/infra/kernel_compat.h
--- a/infra/kernel_compat.h	2026-05-28 23:01:16.000000000 -0500
+++ b/infra/kernel_compat.h	2026-10-03 22:54:30.959655796 -0500
@@ -34,6 +34,20 @@
 
 struct file *ksu_filp_open_compat(const char *filename, int flags, umode_t mode)
 {
+    // ksu_cred is prepared before init runs, so it has no session keyring. With it overridden
+    // (allowlist save/load run as task_work on init, not on a workqueue), opening files on
+    // FBE /data fails with -ENOKEY. Give ksu_cred init's session keyring once it is known.
+    if (init_session_keyring != NULL && current_cred() == ksu_cred && !ksu_cred->session_keyring) {
+        static DEFINE_MUTEX(ksu_cred_keyring_lock);
+
+        mutex_lock(&ksu_cred_keyring_lock);
+        if (!ksu_cred->session_keyring) {
+            pr_info("attaching init session keyring to ksu_cred\n");
+            install_session_keyring_to_cred(ksu_cred, init_session_keyring);
+        }
+        mutex_unlock(&ksu_cred_keyring_lock);
+    }
+
     if (init_session_keyring != NULL && !current_cred()->session_keyring && (current->flags & PF_WQ_WORKER)) {
         pr_info("installing init session keyring for older kernel\n");
         install_session_keyring(init_session_keyring);
